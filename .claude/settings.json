{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && PYTHONPATH=src python3 -m cfa.guard"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && PYTHONPATH=src python3 -m cfa.check_digest --hook"}
        ]
      }
    ]
  }
}
